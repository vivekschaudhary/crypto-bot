# Compass — gitignored derived artifacts
#
# Rule: gitignore only pure views derived from other tracked files with no
# user-relevant state of their own. The dashboard fits — it's a regenerated
# HTML view of artifacts that already live in git. Suppressions, refinement
# logs, metrics snapshots, etc. stay tracked because they carry user state.

# Derived dashboard view — regenerated by /dashboard on demand.
docs/dashboard.html

# ─── App-specific (Next.js + Vercel + pnpm) ─────────────────────────
node_modules/
.next/
out/
.vercel/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# Environment files — never commit secrets. .env.example is the contract.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright e2e artifacts — regenerated each run; never tracked.
test-results/
playwright-report/

# IDE / OS
.DS_Store
.idea/
.vscode/

# pnpm
.pnpm-store/
.vercel
