# Crypto DCA Bot — environment contract.
#
# This file documents required env vars. Real values live in Vercel
# Environment Variables (encrypted). Never commit a populated .env file.
# See docs/ops/runbook.md for setup procedure.

# ─── Coinbase Advanced Trade API ──────────────────────────────────────
# Trade-only scoped (no Withdraw, no Transfer) at Coinbase platform.
# Rotation: quarterly per runbook.
COINBASE_API_KEY=""
COINBASE_API_SECRET=""

# ─── Live mode toggle ─────────────────────────────────────────────────
# THE load-bearing safety primitive. Default false. Must remain a SEPARATE
# env var from API keys so accidental flip of one doesn't flip the other.
# When false: bot logs intended trades but never calls Coinbase order endpoints.
LIVE_MODE="false"

# ─── Session signing ──────────────────────────────────────────────────
# HMAC-SHA256 key for signing session cookies. Rotation = forced reauth.
# Generate: `openssl rand -base64 48`
SESSION_SIGNING_SECRET=""

# ─── Recovery code hashing ────────────────────────────────────────────
# Server-side pepper for Argon2id hashing of backup recovery codes.
# Rotation requires regenerating the operator's recovery code.
# Generate: `openssl rand -base64 32`
RECOVERY_CODE_PEPPER=""

# ─── Vercel Cron auth ─────────────────────────────────────────────────
# Vercel-injected when cron fires; checked at /api/cron/tick.
# In production, set this in Vercel dashboard and Vercel injects on cron
# invocations. For local dev, set any non-empty value to exercise the route.
CRON_SECRET=""

# ─── Database ─────────────────────────────────────────────────────────
# Supabase Postgres connection string (use the POOLER endpoint from
# Supabase dashboard → Project Settings → Database → Connection pooling
# → Transaction mode).
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# ─── Origin (used for WebAuthn relying-party config + CSRF origin checks) ─
# Production: your-app.vercel.app
# Local dev: localhost:3000
# Set via Vercel system env var VERCEL_URL where available; this is the override.
APP_ORIGIN=""
